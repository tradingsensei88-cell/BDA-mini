# -----------------------------------------------------------------------------
# CyberShield AI - repository ignore rules
# -----------------------------------------------------------------------------

# Environment / secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Node / Next.js
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Data artifacts (large files should never be committed)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
ml/models/*.pkl
ml/models/*.joblib
ml/models/*.onnx
ml/models/*.parquet

# Logs / coverage
logs/
*.log
coverage/
htmlcov/
.coverage

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Windows-only dev shims + scratch (regenerated by spark_utils.py / never committed)
.tmp_*
.winutils/
.fake_hadoop/
backend/_import_sweep_out.txt
