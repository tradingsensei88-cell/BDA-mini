# Database
POSTGRES_USER=cybershield
POSTGRES_PASSWORD=cybershield_secret
POSTGRES_DB=cybershield
DATABASE_URL=postgresql://cybershield:cybershield_secret@postgres:5432/cybershield

# Redis
REDIS_URL=redis://redis:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EXTERNAL_SERVERS=localhost:29092

# HDFS
HDFS_NAMENODE_URL=hdfs://namenode:8020
HDFS_WEB_URL=http://namenode:9870

# Spark
SPARK_MASTER_URL=spark://spark-master:7077

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
